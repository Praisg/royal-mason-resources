# Client-exposed Vite env (baked in at build time on Heroku)
# Set these with: heroku config:set VITE_WHATSAPP_NUMBER=263789569999
# Then rebuild: git commit --allow-empty -m "rebuild" && git push heroku main

# Digits only, no + or spaces
VITE_WHATSAPP_NUMBER=263789569999

VITE_CONTACT_EMAIL=royalmasonresources@outlook.com

# Optional: Formspree form ID (https://formspree.io) for contact form posts
# VITE_FORMSPREE_ID=xxxxxxxx
